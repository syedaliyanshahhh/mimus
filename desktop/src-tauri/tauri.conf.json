{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimus",
  "version": "0.1.0",
  "identifier": "io.getmimus.desktop",
  "build": {
    "frontendDist": "https://getmimus.io"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mimus"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb"],
    "category": "Productivity",
    "shortDescription": "Mimus, your AI teammate",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
